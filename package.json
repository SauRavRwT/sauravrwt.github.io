{
  "private": true,
  "name": "sauravrwt.github.io",
  "version": "3.0.0",
  "description": "Personal portfolio of Saurav Rawat — Data Analyst & front-end developer.",
  "homepage": "https://sauravrwt.github.io",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,mjs,md}\"",
    "fetch-data": "node git_data_fetcher.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d dist"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.2.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^5.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^6.2.0",
    "gh-pages": "^6.1.1",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "2.0.5",
    "vite": "^8.0.13"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,css,md}": "prettier --write"
  }
}
